# Copy to /etc/systemd/system/chatformme.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now chatformme
# Put secrets (CHAT_PASSWORD, ADMIN_KEY, CHAT_TITLE) in /etc/chatformme.env

[Unit]
Description=chatformme emergency chat
After=network.target

[Service]
ExecStart=/usr/bin/node /opt/chatformme/server.js
WorkingDirectory=/opt/chatformme
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=TRUST_PROXY=1
Environment=DATA_DIR=/var/lib/chatformme
EnvironmentFile=-/etc/chatformme.env
DynamicUser=yes
StateDirectory=chatformme
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
